// Generates vectors/audit-seal-vectors.json, consumed by BOTH test/audit-seal-vectors.test.ts (TS) and
// python/tests/test_seal.py (Python). They pin the seal primitive (entry_hash = sha256(JCS(core));
// entry_hmac = HMAC-SHA256(key, sameBytes)) byte-for-byte across languages, and the verdict both
// verifiers must reach on a set of chains. Run: npm run vectors
// The vector groups live in scripts/audit-vectors/: fixtures (the public test key and base chain),
// chains, matrix and order (value-level verify vectors), files and respell (canonical-JSONL files, incl.
// generated sizes), derive (the derivation rules every harness applies) and selfcheck (TS must agree).

import { createHash, createHmac } from 'node:crypto';
import { mkdirSync, writeFileSync } from 'node:fs';
import { dirname, join } from 'node:path';
import { fileURLToPath } from 'node:url';
import { canonicalize } from '../src/canonicalize.js';
import { ANCHOR_VECTORS, STRUCTURAL_VECTORS, VECTORS, VERIFY_VECTORS } from './audit-vectors/chains.mjs';
import { derivedCases, sizeVectorCases, type Case, type Derivations } from './audit-vectors/derive.mjs';
import { JSONL_VECTORS, fileTwinOf, jsonlSizeVectors } from './audit-vectors/files.mjs';
import { GENESIS, KEY_HEX, full, key } from './audit-vectors/fixtures.mjs';
import {
  ANCHORED_FORGERY_VECTORS, APPENDED_VECTORS, CORE_MEMBER_VECTORS, DERIVED_FIELD_VECTORS, KEYRING_EDGE_VECTORS,
  LINK_TYPE_VECTORS,
} from './audit-vectors/matrix.mjs';
import { CORE_DEFINITION_FILES, CORE_DEFINITION_VECTORS } from './audit-vectors/core.mjs';
import { ORDER_AND_EXACTNESS_VECTORS } from './audit-vectors/order.mjs';
import { respellingVectors } from './audit-vectors/respell.mjs';
import { assertTypeScriptVerdicts, assertUniqueNames } from './audit-vectors/selfcheck.mjs';

const here = dirname(fileURLToPath(import.meta.url));
const outPath = join(here, '..', 'vectors', 'audit-seal-vectors.json');
const LF = String.fromCharCode(10);
const NUL = String.fromCharCode(0);
const hexOf = (text: string): string => Buffer.from(text, 'utf8').toString('hex');

const verifyVectors = [
  ...VERIFY_VECTORS, ...STRUCTURAL_VECTORS, ...ANCHOR_VECTORS, ...DERIVED_FIELD_VECTORS, ...APPENDED_VECTORS,
  ...LINK_TYPE_VECTORS, ...ANCHORED_FORGERY_VECTORS, ...CORE_MEMBER_VECTORS, ...KEYRING_EDGE_VECTORS,
  ...ORDER_AND_EXACTNESS_VECTORS, ...CORE_DEFINITION_VECTORS,
];
// Every verify vector that can be written as canonical JSONL also appears as a file (<name>-file).
const jsonlVectors = [...JSONL_VECTORS, ...verifyVectors.flatMap(fileTwinOf), ...CORE_DEFINITION_FILES, ...respellingVectors()].map(({ name, data, ...v }) => ({ name, data_hex: data.toString('hex'), ...v }));
const sizeVectors = jsonlSizeVectors();

// The constants of the derivation rules (see scripts/audit-vectors/derive.mts). The later entry is a
// keyless forgery of the base chain's entry 0 (one member added, stale seal).
const FORGED_MEMBER = 'forged_without_the_key';
const laterEntry = { ...full[0]!, [FORGED_MEMBER]: true };
const DERIVATIONS: Derivations = {
  later_entry: laterEntry,
  later_lines_hex: [canonicalize(laterEntry) + LF, `junk${LF}`, '{"torn'].map(hexOf),
  // Lines a lenient JSONL reader would skip: comments, NUL lines, bare literals and an empty object.
  inserted_lines_hex: ['# comment', '// comment', NUL, NUL + NUL, 'true', 'false', 'null', '{}'].map((line) => hexOf(line + LF)),
  ignored_anchors: [{ count: 1000, last_hash: 'f'.repeat(64) }, { count: 0, last_hash: GENESIS }],
  genesis_hash: GENESIS,
  max_depth: 2,
};

const KEYRING = { 'k1': KEY_HEX };
assertUniqueNames([...verifyVectors, ...jsonlVectors, ...sizeVectors]);
const baseCases: Case[] = [
  ...verifyVectors,
  ...jsonlVectors.map(({ data_hex, ...v }) => ({ ...v, data: Buffer.from(data_hex, 'hex') })),
  ...sizeVectors.flatMap(sizeVectorCases),
];
const allCases = baseCases.flatMap((c) => [c, ...derivedCases(c, DERIVATIONS)]);
assertTypeScriptVerdicts(allCases, KEYRING);

const out = {
  _comment:
    'GENERATED by scripts/emit-audit-vectors.mts -- do not hand-edit. Normative seal + verify vectors. ' +
    'vectors: entry_hash = sha256(canonical(core)), entry_hmac = HMAC-SHA256(key_hex, same bytes). ' +
    'verify_vectors: both verifiers must return exactly expect (ok, last_seq) and never throw; anchor, when ' +
    'present, is passed as the external (count, last_hash) anchor; the keyring is {key_id: key_hex} unless the ' +
    'vector gives its own keyring (which may be empty: {} means no keys at all). jsonl_vectors: data_hex is a ' +
    'whole canonical-JSONL file; verify_jsonl must return exactly expect (anchor and keyring as above). ' +
    'jsonl_size_vectors: the file is prefix + unit repeated count times + suffix (UTF-8); value_expect is the ' +
    'verdict of verify_chain on the entries parsed from its lines. derivations: more cases every harness ' +
    'derives, and a conformant verifier must also pass. The cases are every verify vector (its chain), every ' +
    'JSONL vector (its bytes) and every size vector read twice (its file, with expect; its parsed lines as a ' +
    'chain, with value_expect). A case has entry_failure when it is a base case with ok false and no anchor, ' +
    'or any derived case. Apply the rules to every case and to the cases they derive, each rule at most once on ' +
    'a derivation path, up to max_depth rules deep. forged_first: ok false and last_seq >= 0: replace entry 0 ' +
    'by later_entry, a keyless forgery (for a file: line 0 by later_lines_hex[0], its canonical line); expect ok ' +
    'false, last_seq -1. later_failure: entry_failure: append later_entry to ' +
    'a chain (when it is an array), or each of later_lines_hex to a file; expect unchanged. ignored_anchor: ' +
    'entry_failure and no anchor: verify with each of ignored_anchors; expect unchanged. tail_failure: ok true, ' +
    'n = last_seq + 1: append, one at a time, later_entry, a copy of the last entry, a copy of entry 0 and the ' +
    'whole chain again (for a file: each of later_lines_hex and inserted_lines_hex, the last line, line 0 and ' +
    'the whole file again; copies only when n >= 1); expect ok false, last_seq n - 1, as given and, when there ' +
    'is no anchor, also under the true anchor {count: n, last_hash: the last entry_hash, or genesis_hash when ' +
    'n = 0}. head_replay: ok true and n >= 1: insert a copy of entry 0 (line 0) at index 1, and for a file also ' +
    'each of inserted_lines_hex at index 1; expect ok false, last_seq 0. case_count: the number of cases, base and derived; a harness that reaches a different number ' +
    'is not applying the rules.',
  key_hex: KEY_HEX,
  key_id: 'k1',
  derivations: DERIVATIONS,
  case_count: allCases.length,
  vectors: VECTORS.map((v) => {
    const canonical = canonicalize(v.core);
    return {
      name: v.name,
      core: v.core,
      entry_hash: createHash('sha256').update(canonical, 'utf8').digest('hex'),
      entry_hmac: createHmac('sha256', key).update(canonical, 'utf8').digest('hex'),
    };
  }),
  verify_vectors: verifyVectors,
  jsonl_size_vectors: sizeVectors,
  jsonl_vectors: jsonlVectors,
};

mkdirSync(dirname(outPath), { recursive: true });
writeFileSync(outPath, `${JSON.stringify(out, null, 2)}\n`, 'utf8');
console.log(`wrote ${out.vectors.length} audit-seal vectors -> ${outPath}`);
